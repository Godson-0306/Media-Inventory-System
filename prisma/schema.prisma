generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  STAFF
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
}

enum EquipmentCategory {
  AUDIO
  CABLES
  CAMERAS
  COMPUTING
  DISPLAYS
  LIGHTING
  OTHERS
}

enum EquipmentStatus {
  ACTIVE
  SIGNED_OUT
  SIGNED_IN
  FAULTY
}

enum RentalType {
  IN
  OUT
}

enum RentalStatus {
  ACTIVE
  RETURNED
  CANCELLED
}

enum FaultStatus {
  OPEN
  IN_REPAIR
  RESOLVED
}

enum ActivityAction {
  REGISTER
  LOGIN
  ADMIN_UNLOCK
  EQUIPMENT_CREATED
  EQUIPMENT_UPDATED
  SIGN_OUT
  SIGN_IN
  RETURN
  FAULT_REPORTED
  FAULT_UPDATED
  RENTAL_CREATED
  RENTAL_RETURNED
  SAMPLE_SEEDED
  REQUEST_CREATED
  REQUEST_APPROVED
  REQUEST_DECLINED
  MEMBER_ADDED
  MEMBER_INVITED
  MEMBER_JOINED
  MEMBER_DISABLED
  MEMBER_ENABLED
  JOIN_CODE_ROTATED
}

enum RequestType {
  SIGN_OUT
  SIGN_IN
  RENTAL_OUT
}

enum RequestStatus {
  PENDING
  APPROVED
  DECLINED
}

model Organization {
  id                   String              @id @default(cuid())
  name                 String
  slug                 String              @unique
  subscriptionStatus   SubscriptionStatus  @default(TRIAL)
  trialEndsAt          DateTime?
  joinCode             String?             @unique
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  users                User[]
  equipment            Equipment[]
  rentals              Rental[]
  faults               Fault[]
  activities           Activity[]
  locationPings        LocationPing[]
  operationRequests    OperationRequest[]
  invites              OrgInvite[]
}

model User {
  id                   String        @id @default(cuid())
  orgId                String
  org                  Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  email                String
  passwordHash         String
  name                 String
  role                 UserRole      @default(OWNER)
  status               UserStatus    @default(ACTIVE)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  activities           Activity[]
  faults               Fault[]
  signedOutEquipment   Equipment[]         @relation("SignedOutBy")
  requestedOperations  OperationRequest[]  @relation("RequestedBy")
  reviewedOperations   OperationRequest[]  @relation("ReviewedBy")
  operatedRequests     OperationRequest[]  @relation("OperatorOnRequest")
  createdInvites       OrgInvite[]         @relation("InviteCreatedBy")

  @@unique([orgId, email])
  @@index([email])
}

model OrgInvite {
  id              String        @id @default(cuid())
  orgId           String
  org             Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  token           String        @unique
  email           String?
  expiresAt       DateTime
  usedAt          DateTime?
  createdByUserId String?
  createdBy       User?         @relation("InviteCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())

  @@index([orgId, usedAt])
}

model Equipment {
  id               String             @id @default(cuid())
  orgId            String
  org              Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name             String
  serialNumber     String
  brand            String
  model            String
  category         EquipmentCategory
  purchaseDate     DateTime?
  warrantyDate     DateTime?
  conditionNotes   String             @default("")
  status           EquipmentStatus    @default(ACTIVE)
  currentOperator  String?
  useCount         Int                @default(0)
  signedOutAt        DateTime?
  signedOutByUserId  String?
  signedOutBy        User?              @relation("SignedOutBy", fields: [signedOutByUserId], references: [id], onDelete: SetNull)
  locationLabel      String?
  locationAddress    String?
  latitude           Float?
  longitude          Float?
  liveLatitude       Float?
  liveLongitude      Float?
  liveAccuracy       Float?
  liveUpdatedAt      DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  rentals            Rental[]
  faults             Fault[]
  activities         Activity[]
  locationPings      LocationPing[]
  operationRequests  OperationRequest[]

  @@unique([orgId, serialNumber])
  @@index([signedOutByUserId])
}

model LocationPing {
  id           String        @id @default(cuid())
  orgId        String
  org          Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  equipmentId  String
  equipment    Equipment     @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  latitude     Float
  longitude    Float
  accuracy     Float?
  createdAt    DateTime      @default(now())

  @@index([equipmentId, createdAt])
  @@index([orgId, createdAt])
}

model OperationRequest {
  id                 String          @id @default(cuid())
  orgId              String
  org                Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  equipmentId        String
  equipment          Equipment       @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  requesterId        String
  requester          User            @relation("RequestedBy", fields: [requesterId], references: [id], onDelete: Cascade)
  operatorUserId     String?
  operator           User?           @relation("OperatorOnRequest", fields: [operatorUserId], references: [id], onDelete: SetNull)
  type               RequestType
  status             RequestStatus   @default(PENDING)
  operatorName       String
  notes              String          @default("")
  locationLabel      String?
  locationAddress    String?
  latitude           Float?
  longitude          Float?
  counterparty       String?
  startDate          DateTime?
  endDate            DateTime?
  reviewedByUserId   String?
  reviewedBy         User?           @relation("ReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewedAt         DateTime?
  declineReason      String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([orgId, status, createdAt])
  @@index([equipmentId, status])
}

model Rental {
  id            String         @id @default(cuid())
  orgId         String
  org           Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  equipmentId   String?
  equipment     Equipment?     @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  type          RentalType
  counterparty  String
  startDate     DateTime
  endDate       DateTime?
  status        RentalStatus   @default(ACTIVE)
  notes         String         @default("")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Fault {
  id           String        @id @default(cuid())
  orgId        String
  org          Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  equipmentId  String
  equipment    Equipment     @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  reporterId   String
  reporter     User          @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  description  String
  status       FaultStatus   @default(OPEN)
  reportedAt   DateTime      @default(now())
  resolvedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Activity {
  id           String          @id @default(cuid())
  orgId        String
  org          Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  equipmentId  String?
  equipment    Equipment?      @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  action       ActivityAction
  details      Json?
  createdAt    DateTime        @default(now())

  @@index([orgId, createdAt])
}
